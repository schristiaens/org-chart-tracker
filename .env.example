# bhr-org-tracker configuration.
# Copy the lines you need into ~/.secrets.env (chmod 600) — the installers
# generate a runner that sources that file at run time, so nothing lands in a
# plist or a systemd unit.

# ---- BambooHR (required) -------------------------------------------------
export BHR_SUBDOMAIN=acme                    # or acme.bamboohr.com, or the full URL
export BHR_PERSONAL_API_KEY=...              # BambooHR > your profile > API Keys

# Only for the fallback org-chart crawl (needs `pdftotext` from poppler):
# export BHR_SESSION_COOKIE='...'            # Cookie header from a logged-in session

# ---- Email via SMTP (optional; needed for --email) ----------------------
# To turn email on, uncomment the three lines below and fill them in. Leave
# them commented to skip email: set but unusable values fail every run.
# BHR_SMTP_PASSWORD must be an APP-SPECIFIC PASSWORD, not your account
# password -- Google: myaccount.google.com/apppasswords; Fastmail: Settings >
# Privacy & Security > Integrations > New app password (Mail/SMTP). Account
# passwords will not authenticate with 2FA enabled.
# export BHR_SMTP_USER=you@example.com       # full address; also the default From
# export BHR_SMTP_PASSWORD=...               # app password
# export BHR_MAIL_TO=you@example.com         # comma-separated for several

# Optional:
# export BHR_SMTP_HOST=smtp.gmail.com        # default; e.g. smtp.fastmail.com
# export BHR_SMTP_PORT=465                   # 465 implicit TLS (default), 587 STARTTLS
# export BHR_MAIL_FROM=you@example.com       # defaults to BHR_SMTP_USER
# export BHR_MAIL_ATTACH_CSV=1               # attach the change list as a CSV.
#                                            # OFF by default on purpose: it is
#                                            # the people in the email body plus
#                                            # their employee IDs and divisions.
#                                            # Turning it on mails that to your
#                                            # mailbox -- your call, made explicitly.
#                                            # The full roster is never mailed.

# ---- Behaviour (optional) ------------------------------------------------
# export BHR_ORG_TRACKER_HOME=/srv/bhr-org-tracker   # where data is written
# BHR_SECRETS_FILE (where the runner reads this file) does nothing in here:
# set it in your shell when you run an installer or onboard.py.
# export BHR_ALLOW_SHRINK=1                          # permit a >50% roster drop
# export BHR_TRACKER_ONCALENDAR='*-*-* 09:05:00'     # systemd schedule
# export BHR_TRACKER_HOUR=9                          # launchd schedule (macOS)
# export BHR_TRACKER_MINUTE=5


# Roll-ups need no configuration: the daily runner calls `--rollup auto`, which
# produces the weekly (Mondays) and monthly (first weekday of the month)
# roll-ups from stored snapshots and emails them to BHR_MAIL_TO.
